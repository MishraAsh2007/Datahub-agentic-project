# Copy this file to .env and fill in your own key.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# .env is gitignored, so your key never gets committed.

# REQUIRED. Get a free key at https://console.groq.com/keys
# Free-tier keys work fine; this project was built on one.
GROQ_API_KEY=gsk_your_key_here

# OPTIONAL. Which Groq model the agent runs on.
#   openai/gpt-oss-20b   fast and cheap, good for iterating
#   openai/gpt-oss-120b  better at multi-step tool use (default)
# Free tier allows 8000 tokens per minute on either. The agent trims its own
# history to stay under that; see HISTORY_TOKEN_BUDGET in model.py.
WINNOW_MODEL=openai/gpt-oss-120b

# OPTIONAL. Where DataHub's metadata API (GMS) is listening.
# This is the API port, NOT 9002 which serves the web UI.
DATAHUB_GMS_URL=http://localhost:8080
